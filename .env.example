# Copy these into your host's environment variables (or into .env for local use).
# Create the first two with:  ADMIN_PASSWORD='your password' npm run admin:setup   (stores only a hash, never the password)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional: better movie and series search with posters (free key from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Where edits are saved. Leave empty to use a local file (data/content.json).
# On Vercel, add an Upstash Redis / Vercel KV store and these are filled in for you:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
