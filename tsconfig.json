{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "types": [
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "astryx-themes.js",
    "shared"
  ]
}